# two-years 的运行配置。deploy.sh 会用当前环境变量里的值覆写这个文件。
#
#   权限必须是 0600、属主 root：里面是两个人的生日。
#   改完只要 systemctl restart two-years —— src/auth.js 每次启动都从环境变量重算哈希，
#   不需要重跑 seed，也不需要动数据库。
#
# ⚠️ DOOR_PASSWORD / HERO_PASSWORD 必须由环境变量显式注入（deploy.sh 把「没注入」
#    做成硬失败，不是一行注释）。这里留空就是模板，不是来源。

# 绑定地址。**必须是回环**：nginx 在这台机器上反代，绑 0.0.0.0 等于在公网 IP 上
# 另开一个裸 HTTP 入口，可以绕开证书直达应用 —— 那时 cookie 不带 Secure，凭据明文发。
# deploy.sh 每次都会把这一行重写成 127.0.0.1；要改必须 root 手改这个文件（它是 0600）。
HOST=127.0.0.1

PORT=8300
DATA_DIR=/opt/two-years/data

# 对方的生日：4 位月日或 8 位完整生日都行。
# ⚠️ 这里是**模板，不是来源**。真实值只放在服务器上那个 0600 root 的文件里。
#    本文件一旦填了真值并被提交，口令就等于公开了 —— src/ 侧已无缺省值可依赖。
DOOR_PASSWORD=
HERO_PASSWORD=

# 观察者 PIN：能一次读全双方内容且**不受时间锁约束**，所以它最需要独立凭据。
# ⚠️ 它的值与上面两个**必须不同**：同值等于一把钥匙开两个门。
#    形态与生日无关（不是纯数字也可以），至少 6 位。
#    deploy.sh 会校验这三者两两不同，不满足直接 exit 1。
OBSERVER_PASSWORD=

# 出生年份：只用于把 4 位月日补成 8 位（CONSTRAINTS §3 的容错）。
# 登录时不校验年份，所以它错了不会让口令失效，但会让 8 位形态对不上。
BIRTH_YEAR=2004
